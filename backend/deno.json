{
  "name": "hive-ai",
  "version": "0.1.0",
  "exports": "./main.ts",
  "compilerOptions": {
    "types": ["npm:@types/node"]
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env main.ts"
  },
  "imports": {
    "@langchain/core": "npm:@langchain/core@^1.2.9",
    "@langchain/langgraph": "npm:@langchain/langgraph@^1.4.12",
    "@langchain/ollama": "npm:@langchain/ollama@^1.3.0",
    "@std/assert": "jsr:@std/assert@1",
    "dotenv": "npm:dotenv@^17.4.2",
    "zod": "npm:zod@^4.4.3",
    "zod-to-json-schema": "npm:zod-to-json-schema@^3.25.2"
  },
  "nodeModulesDir": "auto",
  "desktop": {
    "app": {
      "name": "HiveAI",
      "identifier": "com.hiveai.desktop",
      "icons": {
        "macos": "./icons/app.icns",
        "windows": "./icons/app.ico",
        "linux": "./icons/app.png"
      },
      "deepLinks": ["hiveai"]
    },
    "backend": "webview",
    "output": {
      "macos": "./dist/HiveAI.app",
      "windows": "./dist/HiveAI",
      "linux": "./dist/hive-ai"
    }
  }
}
