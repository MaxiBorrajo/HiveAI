{
  "name": "hive-ai",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --watch --allow-net main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "desktop": {
    "app": {
      "name": "HiveAI",
      "identifier": "com.hiveai.desktop",
      "icons": {
        "macos": "./icons/app.icns",
        "windows": "./icons/app.ico",
        "linux": "./icons/app.png"
      },
      "deepLinks": ["hiveai"]
    },
    "backend": "webview",
    "output": {
      "macos": "./dist/HiveAI.app",
      "windows": "./dist/HiveAI",
      "linux": "./dist/hive-ai"
    }
  }
}
